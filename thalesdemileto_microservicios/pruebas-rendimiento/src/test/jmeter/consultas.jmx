<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree>
<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Consultas autenticadas - cinco microservicios" enabled="true">
<boolProp name="TestPlan.functional_mode">false</boolProp>
<elementProp name="TestPlan.user_defined_variables" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
</TestPlan><hashTree>
<ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Usuarios virtuales" enabled="true">
<stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
<elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Repetir">
<boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">-1</stringProp></elementProp>
<stringProp name="ThreadGroup.num_threads">${__P(users,1)}</stringProp><stringProp name="ThreadGroup.ramp_time">${__P(ramp,1)}</stringProp>
<boolProp name="ThreadGroup.scheduler">true</boolProp><stringProp name="ThreadGroup.duration">${__P(duration,20)}</stringProp><stringProp name="ThreadGroup.delay">0</stringProp>
</ThreadGroup><hashTree>
<HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Autenticacion" enabled="true">
<collectionProp name="HeaderManager.headers">
<elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${__groovy(System.getenv(&quot;LOAD_TOKEN&quot;))}</stringProp></elementProp>
<elementProp name="" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
</collectionProp></HeaderManager><hashTree/>
<ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Pausa antes de cada solicitud" enabled="true"><stringProp name="ConstantTimer.delay">${__P(pause,1000)}</stringProp></ConstantTimer><hashTree/>
<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="HTTP 200 y arreglo JSON valido" enabled="true">
<stringProp name="scriptLanguage">groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp>
<stringProp name="script">if (prev.getResponseCode() != '200') {
 AssertionResult.setFailure(true)
 AssertionResult.setFailureMessage('Se esperaba HTTP 200: ' + prev.getResponseCode())
} else {
 try {
  def body = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
  if (!(body instanceof List)) throw new IllegalStateException('Se esperaba un arreglo JSON')
 } catch (Exception e) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage('Respuesta funcional invalida: ' + e.message)
 }
}</stringProp>
</JSR223Assertion><hashTree/>
